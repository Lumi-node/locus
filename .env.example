# Locus environment template — copy to .env and fill in.

# Solana
SOLANA_RPC=https://api.devnet.solana.com
LOCUS_KEYPAIR=/home/lumi-node/.config/solana/locus-dev.json
LOCUS_PROGRAM_ID=

# Helius (Enhanced Tx API — free tier is fine for the demo)
HELIUS_API_KEY=

# ARMS service
ARMS_URL=http://localhost:8080
ARMS_DIM=64

# Logging
RUST_LOG=locus_demo=info,locus_relayer=info,locus_client=info,arms_service=info
